# 群星 Star — .gitignore

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# 虚拟环境
.venv/
.venv-*/
venv/
env/

# 日志
logs/
*.log
*.log.zip

# 数据
data/
*.db
*.sqlite

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

# 环境变量
.env
.env.local

# 本机配置（含本机独有的 API Key，首次启动由 config.example.yaml 自动生成）
config.yaml

# 临时文件
tmp/
temp/

# AI 助手工作目录（脚本草稿、会话缓存，不入库）
.comate/
.dumate/
.workbuddy/

# bootstrap_env.py 就地安装的依赖
.pylibs/

# 截图产物
screenshots/
screenshot_*.png
